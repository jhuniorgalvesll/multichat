{
  "name": "multichat",
  "productName": "MultiChat",
  "version": "1.17.3",
  "description": "MultiChat Pro — varias cuentas de WhatsApp, Telegram y más en una sola app. Creado por lliuya.pe.",
  "main": "src/main.js",
  "author": "lliuya.pe",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.multichat.app",
    "productName": "MultiChat",
    "files": [
      "src/**",
      "ui/**",
      "build/icon.png",
      "!**/node_modules/**/*.{map,d.ts,d.mts,d.cts,md,markdown}",
      "!**/node_modules/**/*.mjs",
      "!**/node_modules/@anthropic-ai/sdk/src/**",
      "!**/node_modules/**/{test,tests,__tests__,docs,example,examples}/**"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "jhuniorgalvesll",
      "repo": "multichat",
      "releaseType": "draft"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "MultiChat-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "compression": "maximum",
    "dmg": {
      "title": "MultiChat ${version}",
      "artifactName": "MultiChat-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "electron-updater": "^6.8.11"
  }
}
